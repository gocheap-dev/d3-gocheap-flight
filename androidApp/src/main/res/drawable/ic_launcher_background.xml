<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's background layer: flat white, which is what the logo is drawn to sit on.

  A vector rather than five PNGs because it is one rectangle — the system scales it to whatever
  the launcher's mask needs, and a solid fill costs nothing at any size.

  Replaces Android Studio's default green keyline grid, which was still here from the project
  template.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M0,0h108v108h-108z" />
</vector>
