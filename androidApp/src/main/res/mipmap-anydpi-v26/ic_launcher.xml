<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon every supported device actually draws: minSdk is 26, so the legacy PNGs beside this
  are only ever read by surfaces that bypass the launcher.

  The foreground is a bitmap rather than a vector because the logo is one — there is no path
  data to convert, and a traced approximation of a gradient-filled mark would be worse than the
  artwork itself. It is sized so the whole mark clears the 66dp circle the platform guarantees;
  see the generator note in the commit.

  `monochrome` is what Android 13's themed icons tint to the user's wallpaper palette. Without it
  the launcher falls back to shrinking the full-colour icon into a grey circle, which is the
  shrunken-logo-on-grey look that reads as an app that was never updated.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
